// Fine Bakery & Bistro — data model
// Everything the admin panel can edit lives here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Course {
  SOUP
  MAIN_ONE
  MAIN_TWO
  DESSERT
  DAILY_SPECIAL
}

/// Admin panel account.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One calendar week of daily menus. Publishing a week makes it public.
model MenuWeek {
  id         String      @id @default(cuid())
  /// ISO week number, 1–53.
  weekNumber Int
  year       Int
  published  Boolean     @default(false)
  note       String?
  days       DailyMenu[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([year, weekNumber])
}

/// The menu for a single day of a week.
model DailyMenu {
  id      String     @id @default(cuid())
  weekId  String
  week    MenuWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekday Weekday
  /// Concrete date, useful for "menu for the 14th" style lookups.
  date    DateTime?
  items   MenuItem[]

  @@unique([weekId, weekday])
}

/// A single line of a daily menu: soup, main 1, main 2, dessert, daily special.
model MenuItem {
  id          String    @id @default(cuid())
  dailyMenuId String
  dailyMenu   DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  course      Course
  name        String
  /// Allergen numbers rendered in brackets after the dish name.
  allergens   Int[]
  /// Null for courses included in the menu price (soup, dessert).
  price       Decimal?  @db.Decimal(6, 2)
  position    Int       @default(0)

  @@index([dailyMenuId])
}

/// Dishes available the whole week, shown under the "Týždenné menu" tab.
model WeeklyDish {
  id          String             @id @default(cuid())
  name        String
  description String
  allergens   Int[]
  price       Decimal            @db.Decimal(6, 2)
  active      Boolean            @default(true)
  position    Int                @default(0)
  options     WeeklyDishOption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// "Na výber" chips — protein or side choices for a weekly dish.
model WeeklyDishOption {
  id       String     @id @default(cuid())
  dishId   String
  dish     WeeklyDish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  label    String
  position Int        @default(0)

  @@index([dishId])
}

/// Legally required allergen legend printed under both menus.
model Allergen {
  id     String @id @default(cuid())
  number Int    @unique
  label  String
}

enum CatalogPage {
  PECIVO
  A_LA_CARTE
  RANAJKY
  NAPOJE
}

/// One line on a standing menu (pečivo, à la carte, raňajky, nápoje).
/// Section keys are fixed in the page layout — only these rows are editable.
model CatalogItem {
  id          String      @id @default(cuid())
  page        CatalogPage
  section     String
  /// Optional group heading inside a section, e.g. "KLASICKÝ" or "Prídavky k šalátu".
  category    String?
  name        String
  description String?
  allergens   Int[]
  /// Weight or volume shown under the name — "200 g", "0,25 l".
  portion     String?
  price       Decimal     @db.Decimal(6, 2)
  /// Second price for two sizes, e.g. lemonade 0,3 / 0,5.
  priceAlt    Decimal?    @db.Decimal(6, 2)
  position    Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([page, section])
}

/// One of the four apartments above the bistro. Daily rate is edited in admin.
model Apartment {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  maxGuests   Int      @default(2)
  pricePerDay Decimal  @db.Decimal(6, 2)
  note        String   @default("nad 30 dní cena v zmluve")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Extra fees shown next to the apartment price cards.
model ApartmentSettings {
  id                String   @id @default("default")
  extraPersonPerDay Decimal  @db.Decimal(6, 2)
  cleaningFee       Decimal  @db.Decimal(6, 2)
  validFrom         String
  updatedAt         DateTime @updatedAt
}

/// Promo event on /akcie. Hidden from the public page when inactive.
model Event {
  id        String   @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pop-up shown to visitors on the public site — picture plus text, switched on from the admin panel.
model AlertWindow {
  id          String    @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  buttonLabel String?
  buttonUrl   String?
  active      Boolean   @default(false)
  /// Optional schedule. Empty means "show as long as it is active".
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
