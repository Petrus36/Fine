# Postgres connection string (Prisma). Locally, use your Neon URL.
# On Vercel Postgres, POSTGRES_PRISMA_URL / Storage_POSTGRES_PRISMA_URL also work.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fine?sslmode=require"

# Signs the admin session cookie — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend — kontaktný formulár (/kontakt)
# API key: https://resend.com/api-keys
Fine_API_Resender=""
# Verified sender in Resend (until domain is verified, use onboarding@resend.dev)
RESEND_FROM_EMAIL="Fine Bakery & Bistro <onboarding@resend.dev>"
# Where contact form messages are delivered
CONTACT_EMAIL_TO="fine@finerestaurant.sk"
