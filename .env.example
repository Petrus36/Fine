# Postgres connection string (Prisma). Locally, use your Neon URL.
# On Vercel Postgres, POSTGRES_PRISMA_URL / Storage_POSTGRES_PRISMA_URL also work.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fine?sslmode=require"

# Signs the admin session cookie — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional. Set on Vercel so admin image uploads go to Blob storage instead of
# the (read-only) serverless filesystem.
BLOB_READ_WRITE_TOKEN=""
